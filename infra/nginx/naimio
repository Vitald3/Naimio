# ==============================================================================
# Naimio Production Host Nginx Configuration
# File on VPS: /etc/nginx/sites-available/naimio
# Symlink: ln -s /etc/nginx/sites-available/naimio /etc/nginx/sites-enabled/
# ==============================================================================

# WebSocket upgrade mapping
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# Upstream Docker container endpoints (bound strictly to 127.0.0.1)
upstream naimio_web {
    server 127.0.0.1:3000;
    keepalive 32;
}

upstream naimio_api {
    server 127.0.0.1:8080;
    keepalive 64;
}

# ------------------------------------------------------------------------------
# HTTP (Port 80) -> Redirect to HTTPS + ACME Challenge Support
# ------------------------------------------------------------------------------
server {
    listen 80;
    listen [::]:80;
    server_name naimio.ru www.naimio.ru;

    # Let's Encrypt ACME renewal challenge
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
        try_files $uri =404;
    }

    location / {
        return 301 https://naimio.ru$request_uri;
    }
}

# ------------------------------------------------------------------------------
# HTTPS (Port 443) -> WWW to Non-WWW Canonical Redirect
# ------------------------------------------------------------------------------
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name www.naimio.ru;

    # Let's Encrypt certificates
    ssl_certificate /etc/letsencrypt/live/naimio.ru/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/naimio.ru/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers off;

    return 301 https://naimio.ru$request_uri;
}

# ------------------------------------------------------------------------------
# HTTPS (Port 443) -> Main Canonical Server
# ------------------------------------------------------------------------------
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name naimio.ru;

    # SSL / TLS Configuration
    ssl_certificate /etc/letsencrypt/live/naimio.ru/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/naimio.ru/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    # Max upload body size for portfolio images and documents
    client_max_body_size 25m;

    # Gzip Compression
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_types application/json text/css application/javascript image/svg+xml text/plain;

    # Security Headers
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(self), geolocation=(), payment=()" always;
    add_header Content-Security-Policy "default-src 'self'; base-uri 'self'; frame-ancestors 'none'; object-src 'none'; img-src 'self' https: data: blob:; media-src 'self' https:; connect-src 'self' wss://naimio.ru https:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; font-src 'self' data: https:; form-action 'self'; upgrade-insecure-requests" always;

    # Proxy Headers
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    proxy_connect_timeout 5s;
    proxy_send_timeout 30s;
    proxy_read_timeout 30s;

    # --------------------------------------------------------------------------
    # WebSocket Endpoints (User Realtime Chat & Admin Support Realtime)
    # --------------------------------------------------------------------------
    location = /api/v1/ws {
        proxy_pass http://naimio_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 70s;
        proxy_send_timeout 70s;
        proxy_buffering off;
    }

    location = /api/v1/admin/support/ws {
        proxy_pass http://naimio_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 70s;
        proxy_send_timeout 70s;
        proxy_buffering off;
    }

    # --------------------------------------------------------------------------
    # REST API & Healthchecks
    # --------------------------------------------------------------------------
    location /api/ {
        proxy_pass http://naimio_api;
    }

    location /health/ {
        proxy_pass http://naimio_api;
        proxy_read_timeout 5s;
    }

    # --------------------------------------------------------------------------
    # Next.js Static Assets (Immutable Cache)
    # --------------------------------------------------------------------------
    location /_next/static/ {
        proxy_pass http://naimio_web;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # --------------------------------------------------------------------------
    # Next.js Frontend Application (SSR & Client Pages)
    # --------------------------------------------------------------------------
    location / {
        proxy_pass http://naimio_web;
    }
}
